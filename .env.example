# MongoDB connection — local on Hetzner VPS
MONGO_URI=mongodb://localhost:27017/marksheet_scanner

# JWT secret — change this to a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT expiry
JWT_EXPIRES_IN=30d

# Server port
PORT=3000

# Environment
NODE_ENV=production

# Admin secret for notification panel (change this!)
ADMIN_SECRET=skyup_admin_change_this_secret

# Firebase service account key path
FIREBASE_KEY_PATH=./firebase-service-account.json

# Firebase V1 API uses service account (no server key needed)
# Place firebase-service-account.json in the backend root folder

# Admin secret for sending notifications
ADMIN_SECRET=skyup_admin_change_this
