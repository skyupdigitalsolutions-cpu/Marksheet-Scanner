# Copy this to .env and fill in your values

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/marksheet_scanner

# JWT settings
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=30d

# Server
PORT=3000
NODE_ENV=production

# Google Gemini API key (get from aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Admin panel password (for admin.html)
ADMIN_SECRET=change_this_to_something_secret

# Firebase (for push notifications)
# Option A: Paste the entire firebase-service-account.json as one line:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# Option B: Place firebase-service-account.json file in project root

# Razorpay (for scan-credit recharge). Get from dashboard.razorpay.com -> Settings -> API Keys.
# Use rzp_test_... keys while testing, rzp_live_... in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Minimum amount (in rupees) a user must pay in one recharge. Enforced server-side.
MIN_RECHARGE_RUPEES=100

# How many scan credits ₹100 buys. e.g. 50 -> ₹2 per scan. Tune to your Gemini cost.
CREDITS_PER_100_RUPEES=50

# Send a "low credits" push notification (via FCM) when a user's balance drops
# to/below this number. Fires once per low-balance episode, resets on recharge.
LOW_CREDIT_THRESHOLD=3
